# Local development only. Copy this file to .env before starting the stack.
COMPOSE_PROJECT_NAME=entertainment-lakehouse

KAFKA_HOST_PORT=29092
OBJECT_STORE_API_PORT=9000
OBJECT_STORE_CONSOLE_PORT=9001
ICEBERG_REST_PORT=8181
TRINO_PORT=8080

OBJECT_STORE_ACCESS_KEY=lakehouse_admin
OBJECT_STORE_SECRET_KEY=change-this-local-password
AWS_REGION=us-east-1

# Optional remote/OCI Kafka TLS/SASL settings. Leave empty for the local broker.
KAFKA_SECURITY_PROTOCOL=
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_SSL_CA_LOCATION=

