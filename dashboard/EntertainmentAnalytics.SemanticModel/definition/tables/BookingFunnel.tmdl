	partition BookingFunnel = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataRoot & "\booking_funnel_daily.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Headers, {"event_date_utc", "destination_type", "destination_id", "booking_type", "channel", "currency", "booking_state_events", "initiated_events", "confirmed_events", "cancelled_events", "refunded_events", "failed_events", "confirmed_quantity", "refunded_quantity", "confirmed_amount", "refunded_amount", "net_booking_value_proxy", "confirmation_share_proxy"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"event_date_utc", type datetimezone}, {"destination_type", type text}, {"destination_id", type text}, {"booking_type", type text}, {"channel", type text}, {"currency", type text}, {"booking_state_events", Int64.Type}, {"initiated_events", Int64.Type}, {"confirmed_events", Int64.Type}, {"cancelled_events", Int64.Type}, {"refunded_events", Int64.Type}, {"failed_events", Int64.Type}, {"confirmed_quantity", Int64.Type}, {"refunded_quantity", Int64.Type}, {"confirmed_amount", type number}, {"refunded_amount", type number}, {"net_booking_value_proxy", type number}, {"confirmation_share_proxy", type number}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

