/// Governed Gold export: booking_funnel_daily.csv. Definitions: docs/gold-metric-definitions.md.
table BookingFunnel
	lineageTag: 3d91fe11-ae8a-443f-b58f-957cc6fc0df5

	measure 'Sự kiện booking' = SUM(BookingFunnel[booking_state_events])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: df1270de-d214-4aad-a8ef-53d21742eb5f

	measure 'Booking xác nhận' = SUM(BookingFunnel[confirmed_events])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: eac035cc-2d57-4f24-9770-d6a12d801354

	measure 'Booking hoàn tiền' = SUM(BookingFunnel[refunded_events])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: a426b227-181c-4543-a2d8-1820f5a31e7a

	measure 'Booking thất bại' = SUM(BookingFunnel[failed_events])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 8def5baa-6578-45c6-bd44-7af7cfad9618

	measure 'Vé xác nhận' = SUM(BookingFunnel[confirmed_quantity])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 309b077f-6fe4-4b59-85a9-e4510f04bdea

	measure 'Giá trị xác nhận' = SUM(BookingFunnel[confirmed_amount])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: e460753a-8240-40f5-bded-0711d9ec0e9a

	measure 'Giá trị hoàn tiền' = SUM(BookingFunnel[refunded_amount])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: ef9d7ac7-907e-4cad-b839-d89446e4efad

	measure 'Giá trị booking ròng proxy' = SUM(BookingFunnel[net_booking_value_proxy])
		formatString: #,0;(#,0)
		displayFolder: Dashboard
		lineageTag: d683d899-369a-4dd1-8504-a534f63ffb45

	measure 'Tỷ trọng xác nhận proxy' = DIVIDE([Booking xác nhận],[Sự kiện booking])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 112f3eeb-c7ee-4d86-9dae-76e0d002bfee

	column event_date_utc
