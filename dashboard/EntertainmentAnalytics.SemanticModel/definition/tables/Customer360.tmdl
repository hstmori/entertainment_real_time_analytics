/// Governed Gold export: customer_360.csv. Definitions: docs/gold-metric-definitions.md.
table Customer360
	lineageTag: cf918a60-d388-449b-94e6-878cc808238e

	measure 'Khách hàng' = COUNTROWS(Customer360)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 193ae060-1962-40e6-bd6f-a309bdac9315

	measure 'Net Spend 12M' = DIVIDE(SUM(Customer360[net_spend_12m]),1000000)
		formatString: #,0.0 "triệu"
		displayFolder: Dashboard
		lineageTag: 48e74363-3073-4f76-95f0-32f9738e2e0b

	measure 'Net Spend TB 12M' = DIVIDE(AVERAGE(Customer360[net_spend_12m]),1000000)
		formatString: #,0.0 "triệu"
		displayFolder: Dashboard
		lineageTag: 8df15869-79a8-4e55-a97e-1ff3d9772e43

	measure 'Customer Value 12M' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),DIVIDE(MAX(Customer360[net_spend_12m]),1000000))
		formatString: #,0.0 "triệu"
		displayFolder: Dashboard
		lineageTag: afe952e5-3bcc-4577-88d1-4bed0f91c7c2

	measure 'Lifetime Value Proxy' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),DIVIDE(MAX(Customer360[lifetime_value_proxy]),1000000))
		formatString: #,0.0 "triệu"
		displayFolder: Dashboard
		lineageTag: 0037301a-49a8-408b-b69a-c1b35397e56d

	measure 'Customer Contribution Margin' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),DIVIDE(MAX(Customer360[contribution_margin_proxy]),1000000))
		formatString: #,0.0 "triệu"
		displayFolder: Dashboard
		lineageTag: 21971bf1-aaa4-49c2-867f-ef0852fd7573

	measure 'Gold+ Customers' = COALESCE(COUNTROWS(FILTER(Customer360,Customer360[gold_plus_flag]=TRUE())),0)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 2a04e528-1e84-4ec5-806c-0315ef5ade9a

	measure 'Gold+ Customer Share' = DIVIDE([Gold+ Customers],[Khách hàng])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 83bd15bb-d1fc-40ec-9039-5069aecf83d8

	measure 'Gold+ Spend' = DIVIDE(CALCULATE(SUM(Customer360[net_spend_12m]),Customer360[gold_plus_flag]=TRUE()),1000000)
		formatString: #,0.0 "triệu"
		displayFolder: Dashboard
		lineageTag: 0c430674-7136-4c7e-8b4c-cf6a82df7ef9

	measure 'Gold+ Spend Share' = DIVIDE(CALCULATE(SUM(Customer360[net_spend_12m]),Customer360[gold_plus_flag]=TRUE()),SUM(Customer360[net_spend_12m]))
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 4eba5845-f103-4ef9-aeb4-fb3fc4fa74b6

	measure 'Khách đa dịch vụ' = COALESCE(COUNTROWS(FILTER(Customer360,Customer360[domain_count]>=3)),0)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: f99cedcd-aeab-45bc-800e-1d5c578576bd

	measure 'Tỷ lệ khách đa dịch vụ' = DIVIDE([Khách đa dịch vụ],[Khách hàng])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 838f96a4-5f7d-4543-9b8f-ea6d696f0426

	measure 'High-spend giảm tương tác' = COALESCE(COUNTROWS(FILTER(Customer360,Customer360[high_spend_low_engagement_flag]=TRUE())),0)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: d85c5a1f-2abd-471d-989e-f18241f25433

	measure 'Engagement Score' = AVERAGE(Customer360[engagement_score])
		formatString: 0.0
		displayFolder: Dashboard
		lineageTag: 8ec80816-70f1-46b0-8287-f68f295f65c3

	measure 'Engagement Score Profile' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[engagement_score]))
		formatString: 0.0
		displayFolder: Dashboard
		lineageTag: ac6a5a59-256b-4985-b1cd-76be9182a489

	measure 'Total Activities Profile' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[total_events]))
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: ff6fe63e-1987-4278-b789-4a5b802206ac

	measure 'Watch Hours Profile' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[watch_hours_90d]))
		formatString: #,0.0
		displayFolder: Dashboard
		lineageTag: 718830d6-8338-494f-9c9c-63940b3e0859

	measure 'Watch Hours TB' = AVERAGE(Customer360[watch_hours_90d])
		formatString: #,0.0
		displayFolder: Dashboard
		lineageTag: 2a2bf9a2-caf2-4a61-8022-365e6152971d

	measure 'Sessions Profile' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[sessions]))
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: f84502de-8ba9-4099-9222-ab7f5d169158

	measure 'Confirmed Tickets Profile' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[confirmed_tickets]))
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: a94a34e5-9b96-408d-87d7-55775c269beb

	measure 'Bookings TB' = AVERAGE(Customer360[confirmed_bookings])
		formatString: 0.0
		displayFolder: Dashboard
		lineageTag: 8738dc99-65bc-44ae-8155-67a53c4e3c40

	measure 'Attendance Profile' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[checked_in_events]))
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 0b12a99c-53db-4a3c-b3aa-aded092dc6e2

	measure 'Attendance TB' = AVERAGE(Customer360[checked_in_events])
		formatString: 0.0
		displayFolder: Dashboard
		lineageTag: d03d3224-c05e-43cc-8fd0-44382a3feb6e

	measure 'Subscription Events Profile' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[subscription_events]))
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: af9ee911-8b17-4f9f-ae6e-e801ec608a3f

	measure 'Subscription Activity TB' = AVERAGE(Customer360[subscription_events])
		formatString: 0.0
		displayFolder: Dashboard
		lineageTag: 38d6f122-47f9-4c06-a786-244a4dfb98e2

	measure 'Completion Rate Profile' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[completion_rate]))
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 9dc4de54-6b15-48cd-b685-c6d2de3919e6

	measure 'Recency TB (ngày)' = AVERAGE(Customer360[recency_days])
		formatString: 0.0
		displayFolder: Dashboard
		lineageTag: 3d3a7f15-8fe7-4b10-b56b-37065bab8bb6

	measure 'Recency Profile' = IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[recency_days]))
		formatString: #,0 ngày
		displayFolder: Dashboard
		lineageTag: c33b64d1-1ffc-4b8d-b3f9-47a80c68a340

	measure 'Active Subscription Customers' = COALESCE(COUNTROWS(FILTER(Customer360,Customer360[active_subscription]=TRUE())),0)
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 9904c738-34d5-45e2-ab09-50452517dabf

	measure 'Member Rank Profile' = SELECTEDVALUE(Customer360[member_rank],"Chọn 1 khách hàng")
		displayFolder: Dashboard
		lineageTag: bcdf89fc-a04a-458f-a72a-293c33355aeb

	measure 'Behavior Risk Profile' = SELECTEDVALUE(Customer360[behavior_risk],"Chọn 1 khách hàng")
		displayFolder: Dashboard
		lineageTag: dbc44296-67ea-4a04-aa6f-5ddbbb3c01ca

	measure 'Màu rủi ro hành vi' = SELECTEDVALUE(Customer360[behavior_risk_color])
		displayFolder: Formatting
		lineageTag: a663cb1f-e8eb-47fd-a93c-a0d081cd5b66

	measure 'Màu hạng thành viên' = SWITCH(SELECTEDVALUE(Customer360[member_rank]), "Diamond", "#20D9E8", "Platinum", "#D9E2EC", "Gold", "#F5C451", "Silver", "#94A3B8", "Basic", "#64748B", BLANK())
		displayFolder: Formatting
		lineageTag: f3b59d35-1417-4388-94b7-e687457a6d6b

