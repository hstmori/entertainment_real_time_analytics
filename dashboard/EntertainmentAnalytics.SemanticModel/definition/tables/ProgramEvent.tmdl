/// Governed Gold export: program_event.csv. Definitions: docs/gold-metric-definitions.md.
table ProgramEvent
	lineageTag: e50e2ecf-a1fd-46a3-955c-6909c0f55be2

	measure 'Số chương trình' = DISTINCTCOUNT(ProgramEvent[program_id])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 24e26178-e783-4c8a-96cf-9586bb347087

	measure 'Sức chứa' = SUM(ProgramEvent[capacity])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: d432fad2-862e-4726-a7af-6a12f8c48aed

	measure 'Vé đã bán' = SUM(ProgramEvent[tickets_sold])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 4fbc325d-5a1e-4f04-aef6-ef249736e923

	measure 'Sell-through Rate' = DIVIDE([Vé đã bán],[Sức chứa])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: cffa92bd-c7b8-4d20-9359-e6b720fd0ce2

	measure 'Ticket GMV' = DIVIDE(SUM(ProgramEvent[ticket_gmv]),1000000000)
		formatString: #,0.0 "tỷ"
		displayFolder: Dashboard
		lineageTag: c532309b-bf8a-455a-879d-e9096b26bb32

	measure 'Doanh thu sự kiện' = DIVIDE(SUM(ProgramEvent[ticket_gmv])+SUM(ProgramEvent[service_fee])+SUM(ProgramEvent[sponsor_revenue])-SUM(ProgramEvent[refund_value]),1000000000)
		formatString: #,0.0 "tỷ"
		displayFolder: Dashboard
		lineageTag: 219e4786-2c33-4fde-8b46-a8369f4fa5dd

	measure 'Event Contribution Margin' = DIVIDE(SUM(ProgramEvent[contribution_margin]),1000000000)
		formatString: #,0.0 "tỷ"
		displayFolder: Dashboard
		lineageTag: fbaaa474-7463-4134-8e85-60308fa587da

	measure 'Event Margin %' = DIVIDE([Event Contribution Margin],[Doanh thu sự kiện])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 52fd8c9c-5719-4154-9bff-431cef25b864

	measure 'Khách tham gia' = SUM(ProgramEvent[attendees])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: b5a372a1-dc1d-48f9-89a6-3624de893983

	measure 'No-show Rate' = DIVIDE(SUM(ProgramEvent[no_shows]),SUM(ProgramEvent[attendees])+SUM(ProgramEvent[no_shows]))
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: 96fca890-bd4a-4968-a1ab-bf9e822df618

	measure 'Sales Pace Index' = AVERAGE(ProgramEvent[sales_pace_index])
		formatString: 0.00
		displayFolder: Dashboard
		lineageTag: 29609436-177b-44a2-9c29-0d9ce0102bcc

	measure 'Tiến độ hòa vốn' = DIVIDE(SUM(ProgramEvent[contribution_margin]),SUM(ProgramEvent[fixed_cost]))
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: b9541c8f-88d3-4ab7-9d3f-737f14dea174

	measure 'Chương trình đạt kế hoạch' = CALCULATE([Số chương trình],ProgramEvent[program_status]="Đúng kế hoạch")
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 863a379d-2b97-4e78-b01c-682a011f92cf

	measure 'Tỷ lệ đạt kế hoạch' = DIVIDE([Chương trình đạt kế hoạch],[Số chương trình])
		formatString: 0.0%
		displayFolder: Dashboard
		lineageTag: b67a76fa-7ea5-4b76-a50e-1938c512fa81

	measure 'Member Conversions' = SUM(ProgramEvent[member_conversions])
		formatString: #,0
		displayFolder: Dashboard
		lineageTag: 6ab00a91-c2dd-4f82-aca2-4e5b4c434ab4

	measure 'Màu trạng thái chương trình' = SWITCH(SELECTEDVALUE(ProgramEvent[program_status]), "Đúng kế hoạch", "#34D399", "Cần theo dõi", "#FBBF24", "Có rủi ro", "#FB923C", "Nghiêm trọng", "#F87171", BLANK())
		displayFolder: Formatting
		lineageTag: eee5a762-2615-4ec2-97ce-59c3049890a6

	column program_id
		dataType: string
		lineageTag: 3d474cd0-e4c3-450a-9b2c-b60062590962
		summarizeBy: none
		sourceColumn: program_id

	column program_name
