	partition ProgramEvent = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataRoot & "\program_event.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Headers, {"program_id", "program_name", "program_type", "region", "event_date_utc", "capacity", "tickets_sold", "ticket_gmv", "service_fee", "sponsor_revenue", "refund_value", "variable_cost", "fixed_cost", "contribution_margin", "attendees", "no_shows", "new_customers", "member_conversions", "sales_pace_index", "break_even_progress", "forecast_margin_rate", "program_status"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"program_id", type text}, {"program_name", type text}, {"program_type", type text}, {"region", type text}, {"event_date_utc", type datetimezone}, {"capacity", Int64.Type}, {"tickets_sold", Int64.Type}, {"ticket_gmv", type number}, {"service_fee", type number}, {"sponsor_revenue", type number}, {"refund_value", type number}, {"variable_cost", type number}, {"fixed_cost", type number}, {"contribution_margin", type number}, {"attendees", Int64.Type}, {"no_shows", Int64.Type}, {"new_customers", Int64.Type}, {"member_conversions", Int64.Type}, {"sales_pace_index", type number}, {"break_even_progress", type number}, {"forecast_margin_rate", type number}, {"program_status", type text}}, "en-US")
				in
				    Typed

	annotation PBI_ResultType = Table

