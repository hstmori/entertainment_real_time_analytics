            "displayFolder": "Dashboard"
          },
          {
            "name": "Marketing Spend",
            "expression": "DIVIDE(SUM(ExecutiveDaily[marketing_spend]),1000000000)",
            "formatString": "#,0.0 \"tỷ\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Mục tiêu doanh thu",
