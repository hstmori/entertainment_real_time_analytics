        "measures": [
          {
            "name": "Customer Activities",
            "expression": "SUM(CustomerActivity[event_count])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Activity Amount",
            "expression": "DIVIDE(SUM(CustomerActivity[amount]),1000000)",
            "formatString": "#,0.0 \"triệu\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Màu kết quả hoạt động",
            "expression": "SWITCH(SELECTEDVALUE(CustomerActivity[activity_result]), \"Thành công\", \"#34D399\", \"Đang xử lý\", \"#FBBF24\", \"Thất bại\", \"#F87171\", \"Thông tin\", \"#9FB3C8\", BLANK())",
            "displayFolder": "Formatting"
          }
        ],
        "partitions": [
          {
            "name": "CustomerActivity",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(DataRoot & \"\\customer_activity.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Selected = Table.SelectColumns(Headers, {\"event_id\", \"customer_id\", \"occurred_at\", \"event_date_utc\", \"event_type\", \"domain\", \"action\", \"activity_label\", \"activity_detail\", \"activity_result\", \"activity_color\", \"source\", \"device_type\", \"content_id\", \"destination_id\", \"plan_id\", \"quantity\", \"amount\", \"currency\", \"event_count\"}),\n    Typed = Table.TransformColumnTypes(Selected, {{\"event_id\", type text}, {\"customer_id\", type text}, {\"occurred_at\", type datetimezone}, {\"event_date_utc\", type datetimezone}, {\"event_type\", type text}, {\"domain\", type text}, {\"action\", type text}, {\"activity_label\", type text}, {\"activity_detail\", type text}, {\"activity_result\", type text}, {\"activity_color\", type text}, {\"source\", type text}, {\"device_type\", type text}, {\"content_id\", type text}, {\"destination_id\", type text}, {\"plan_id\", type text}, {\"quantity\", Int64.Type}, {\"amount\", type number}, {\"currency\", type text}, {\"event_count\", Int64.Type}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      },
