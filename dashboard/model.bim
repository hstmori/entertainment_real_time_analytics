            "formatString": "#,0.0 \"tỷ\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Doanh thu thuần",
            "expression": "DIVIDE(SUM(ExecutiveDaily[net_revenue]),1000000000)",
            "formatString": "#,0.0 \"tỷ\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Chi phí biến đổi",
            "expression": "DIVIDE(SUM(ExecutiveDaily[variable_cost]),1000000000)",
            "formatString": "#,0.0 \"tỷ\"",
            "displayFolder": "Dashboard"
