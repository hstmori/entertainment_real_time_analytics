      {
        "name": "CustomerRankShare",
        "description": "Governed Gold export: customer_rank_share.csv. Definitions: docs/gold-metric-definitions.md.",
        "columns": [
          {
            "name": "metric_type",
            "dataType": "string",
            "sourceColumn": "metric_type",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "member_rank",
            "dataType": "string",
            "sourceColumn": "member_rank",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "member_rank_order",
            "dataType": "int64",
            "sourceColumn": "member_rank_order",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "member_rank_color",
            "dataType": "string",
            "sourceColumn": "member_rank_color",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "metric_value",
            "dataType": "decimal",
            "sourceColumn": "metric_value",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "metric_share",
            "dataType": "double",
            "sourceColumn": "metric_share",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "customer_count",
            "dataType": "int64",
            "sourceColumn": "customer_count",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "net_spend_12m",
            "dataType": "decimal",
            "sourceColumn": "net_spend_12m",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Rank Share",
            "expression": "VAR Metric=SELECTEDVALUE(CustomerRankShare[metric_type]) VAR Ranks=VALUES(CustomerRankShare[member_rank]) VAR Part=IF(Metric=\"Tỷ lệ chi tiêu\",CALCULATE(SUM(Customer360[net_spend_12m]),KEEPFILTERS(TREATAS(Ranks,Customer360[member_rank]))),CALCULATE(COUNTROWS(Customer360),KEEPFILTERS(TREATAS(Ranks,Customer360[member_rank])))) VAR Total=IF(Metric=\"Tỷ lệ chi tiêu\",SUM(Customer360[net_spend_12m]),COUNTROWS(Customer360)) RETURN DIVIDE(Part,Total)",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Rank Customer Count",
            "expression": "MAX(CustomerRankShare[customer_count])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Rank Spend",
            "expression": "DIVIDE(MAX(CustomerRankShare[net_spend_12m]),1000000)",
            "formatString": "#,0.0 \"triệu\"",
            "displayFolder": "Dashboard"
          }
        ],
        "partitions": [
          {
            "name": "CustomerRankShare",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(DataRoot & \"\\customer_rank_share.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Selected = Table.SelectColumns(Headers, {\"metric_type\", \"member_rank\", \"member_rank_order\", \"member_rank_color\", \"metric_value\", \"metric_share\", \"customer_count\", \"net_spend_12m\"}),\n    Typed = Table.TransformColumnTypes(Selected, {{\"metric_type\", type text}, {\"member_rank\", type text}, {\"member_rank_order\", Int64.Type}, {\"member_rank_color\", type text}, {\"metric_value\", type number}, {\"metric_share\", type number}, {\"customer_count\", Int64.Type}, {\"net_spend_12m\", type number}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      },
