        "measures": [
          {
            "name": "Khách hàng",
            "expression": "COUNTROWS(Customer360)",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Net Spend 12M",
            "expression": "DIVIDE(SUM(Customer360[net_spend_12m]),1000000)",
            "formatString": "#,0.0 \"triệu\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Net Spend TB 12M",
            "expression": "DIVIDE(AVERAGE(Customer360[net_spend_12m]),1000000)",
            "formatString": "#,0.0 \"triệu\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Customer Value 12M",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),DIVIDE(MAX(Customer360[net_spend_12m]),1000000))",
            "formatString": "#,0.0 \"triệu\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Lifetime Value Proxy",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),DIVIDE(MAX(Customer360[lifetime_value_proxy]),1000000))",
            "formatString": "#,0.0 \"triệu\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Customer Contribution Margin",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),DIVIDE(MAX(Customer360[contribution_margin_proxy]),1000000))",
            "formatString": "#,0.0 \"triệu\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Gold+ Customers",
            "expression": "COALESCE(COUNTROWS(FILTER(Customer360,Customer360[gold_plus_flag]=TRUE())),0)",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Gold+ Customer Share",
            "expression": "DIVIDE([Gold+ Customers],[Khách hàng])",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Gold+ Spend",
            "expression": "DIVIDE(CALCULATE(SUM(Customer360[net_spend_12m]),Customer360[gold_plus_flag]=TRUE()),1000000)",
            "formatString": "#,0.0 \"triệu\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Gold+ Spend Share",
            "expression": "DIVIDE(CALCULATE(SUM(Customer360[net_spend_12m]),Customer360[gold_plus_flag]=TRUE()),SUM(Customer360[net_spend_12m]))",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Khách đa dịch vụ",
            "expression": "COALESCE(COUNTROWS(FILTER(Customer360,Customer360[domain_count]>=3)),0)",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Tỷ lệ khách đa dịch vụ",
            "expression": "DIVIDE([Khách đa dịch vụ],[Khách hàng])",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "High-spend giảm tương tác",
            "expression": "COALESCE(COUNTROWS(FILTER(Customer360,Customer360[high_spend_low_engagement_flag]=TRUE())),0)",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Engagement Score",
            "expression": "AVERAGE(Customer360[engagement_score])",
            "formatString": "0.0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Engagement Score Profile",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[engagement_score]))",
            "formatString": "0.0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Total Activities Profile",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[total_events]))",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Watch Hours Profile",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[watch_hours_90d]))",
            "formatString": "#,0.0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Watch Hours TB",
            "expression": "AVERAGE(Customer360[watch_hours_90d])",
            "formatString": "#,0.0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Sessions Profile",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[sessions]))",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Confirmed Tickets Profile",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[confirmed_tickets]))",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Bookings TB",
            "expression": "AVERAGE(Customer360[confirmed_bookings])",
            "formatString": "0.0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Attendance Profile",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[checked_in_events]))",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Attendance TB",
            "expression": "AVERAGE(Customer360[checked_in_events])",
            "formatString": "0.0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Subscription Events Profile",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[subscription_events]))",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Subscription Activity TB",
            "expression": "AVERAGE(Customer360[subscription_events])",
            "formatString": "0.0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Completion Rate Profile",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[completion_rate]))",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Recency TB (ngày)",
            "expression": "AVERAGE(Customer360[recency_days])",
            "formatString": "0.0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Recency Profile",
            "expression": "IF(ISFILTERED(Customer360[customer_id]) && HASONEVALUE(Customer360[customer_id]),MAX(Customer360[recency_days]))",
            "formatString": "#,0 ngày",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Active Subscription Customers",
            "expression": "COALESCE(COUNTROWS(FILTER(Customer360,Customer360[active_subscription]=TRUE())),0)",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Member Rank Profile",
            "expression": "SELECTEDVALUE(Customer360[member_rank],\"Chọn 1 khách hàng\")",
            "formatString": "",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Behavior Risk Profile",
            "expression": "SELECTEDVALUE(Customer360[behavior_risk],\"Chọn 1 khách hàng\")",
            "formatString": "",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Màu rủi ro hành vi",
            "expression": "SELECTEDVALUE(Customer360[behavior_risk_color])",
            "displayFolder": "Formatting"
          },
          {
            "name": "Màu hạng thành viên",
            "expression": "SWITCH(SELECTEDVALUE(Customer360[member_rank]), \"Diamond\", \"#20D9E8\", \"Platinum\", \"#D9E2EC\", \"Gold\", \"#F5C451\", \"Silver\", \"#94A3B8\", \"Basic\", \"#64748B\", BLANK())",
            "displayFolder": "Formatting"
          }
        ],
        "partitions": [
          {
            "name": "Customer360",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(DataRoot & \"\\customer_360.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Selected = Table.SelectColumns(Headers, {\"customer_id\", \"unified_customer_id\", \"region\", \"consent_status\", \"preferred_device\", \"first_seen_at\", \"last_seen_at\", \"observed_days\", \"recency_days\", \"total_events\", \"activity_events\", \"active_days\", \"sessions\", \"watch_hours_90d\", \"play_events\", \"completion_events\", \"completion_rate\", \"search_events\", \"favorite_content_id\", \"booking_state_events\", \"confirmed_bookings\", \"refunded_bookings\", \"failed_bookings\", \"confirmed_tickets\", \"ticket_spend_12m\", \"subscription_spend_12m\", \"content_spend_12m\", \"refund_value_12m\", \"net_spend_12m\", \"lifetime_value_proxy\", \"contribution_margin_proxy\", \"attendance_records\", \"checked_in_events\", \"no_show_events\", \"attendance_rate\", \"subscription_events\", \"latest_subscription_status\", \"latest_plan_id\", \"active_subscription\", \"subscription_tenure_months\", \"domain_count\", \"service_mix\", \"engagement_score\", \"behavior_segment\", \"engagement_trend_pct\", \"behavior_risk\", \"behavior_risk_color\", \"member_rank\", \"member_rank_order\", \"member_rank_color\", \"gold_plus_flag\", \"high_spend_low_engagement_flag\", \"next_best_action\", \"profile_note\"}),\n    Typed = Table.TransformColumnTypes(Selected, {{\"customer_id\", type text}, {\"unified_customer_id\", type text}, {\"region\", type text}, {\"consent_status\", type text}, {\"preferred_device\", type text}, {\"first_seen_at\", type datetimezone}, {\"last_seen_at\", type datetimezone}, {\"observed_days\", Int64.Type}, {\"recency_days\", Int64.Type}, {\"total_events\", Int64.Type}, {\"activity_events\", Int64.Type}, {\"active_days\", Int64.Type}, {\"sessions\", Int64.Type}, {\"watch_hours_90d\", type number}, {\"play_events\", Int64.Type}, {\"completion_events\", Int64.Type}, {\"completion_rate\", type number}, {\"search_events\", Int64.Type}, {\"favorite_content_id\", type text}, {\"booking_state_events\", Int64.Type}, {\"confirmed_bookings\", Int64.Type}, {\"refunded_bookings\", Int64.Type}, {\"failed_bookings\", Int64.Type}, {\"confirmed_tickets\", Int64.Type}, {\"ticket_spend_12m\", type number}, {\"subscription_spend_12m\", type number}, {\"content_spend_12m\", type number}, {\"refund_value_12m\", type number}, {\"net_spend_12m\", type number}, {\"lifetime_value_proxy\", type number}, {\"contribution_margin_proxy\", type number}, {\"attendance_records\", Int64.Type}, {\"checked_in_events\", Int64.Type}, {\"no_show_events\", Int64.Type}, {\"attendance_rate\", type number}, {\"subscription_events\", Int64.Type}, {\"latest_subscription_status\", type text}, {\"latest_plan_id\", type text}, {\"active_subscription\", type logical}, {\"subscription_tenure_months\", Int64.Type}, {\"domain_count\", Int64.Type}, {\"service_mix\", type text}, {\"engagement_score\", type number}, {\"behavior_segment\", type text}, {\"engagement_trend_pct\", type number}, {\"behavior_risk\", type text}, {\"behavior_risk_color\", type text}, {\"member_rank\", type text}, {\"member_rank_order\", Int64.Type}, {\"member_rank_color\", type text}, {\"gold_plus_flag\", type logical}, {\"high_spend_low_engagement_flag\", type logical}, {\"next_best_action\", type text}, {\"profile_note\", type text}}, \"en-US\")\nin\n    Typed"
