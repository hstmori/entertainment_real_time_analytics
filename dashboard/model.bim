            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "attendees",
            "dataType": "int64",
            "sourceColumn": "attendees",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "no_shows",
            "dataType": "int64",
            "sourceColumn": "no_shows",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "new_customers",
            "dataType": "int64",
            "sourceColumn": "new_customers",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "member_conversions",
            "dataType": "int64",
            "sourceColumn": "member_conversions",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "sales_pace_index",
            "dataType": "double",
            "sourceColumn": "sales_pace_index",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "break_even_progress",
            "dataType": "double",
            "sourceColumn": "break_even_progress",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "forecast_margin_rate",
            "dataType": "double",
            "sourceColumn": "forecast_margin_rate",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "program_status",
            "dataType": "string",
            "sourceColumn": "program_status",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "measures": [
          {
            "name": "Số chương trình",
            "expression": "DISTINCTCOUNT(ProgramEvent[program_id])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Sức chứa",
            "expression": "SUM(ProgramEvent[capacity])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Vé đã bán",
            "expression": "SUM(ProgramEvent[tickets_sold])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Sell-through Rate",
            "expression": "DIVIDE([Vé đã bán],[Sức chứa])",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Ticket GMV",
            "expression": "DIVIDE(SUM(ProgramEvent[ticket_gmv]),1000000000)",
            "formatString": "#,0.0 \"tỷ\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Doanh thu sự kiện",
            "expression": "DIVIDE(SUM(ProgramEvent[ticket_gmv])+SUM(ProgramEvent[service_fee])+SUM(ProgramEvent[sponsor_revenue])-SUM(ProgramEvent[refund_value]),1000000000)",
            "formatString": "#,0.0 \"tỷ\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Event Contribution Margin",
            "expression": "DIVIDE(SUM(ProgramEvent[contribution_margin]),1000000000)",
            "formatString": "#,0.0 \"tỷ\"",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Event Margin %",
            "expression": "DIVIDE([Event Contribution Margin],[Doanh thu sự kiện])",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Khách tham gia",
            "expression": "SUM(ProgramEvent[attendees])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "No-show Rate",
            "expression": "DIVIDE(SUM(ProgramEvent[no_shows]),SUM(ProgramEvent[attendees])+SUM(ProgramEvent[no_shows]))",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Sales Pace Index",
            "expression": "AVERAGE(ProgramEvent[sales_pace_index])",
            "formatString": "0.00",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Tiến độ hòa vốn",
            "expression": "DIVIDE(SUM(ProgramEvent[contribution_margin]),SUM(ProgramEvent[fixed_cost]))",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Chương trình đạt kế hoạch",
            "expression": "CALCULATE([Số chương trình],ProgramEvent[program_status]=\"Đúng kế hoạch\")",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Tỷ lệ đạt kế hoạch",
            "expression": "DIVIDE([Chương trình đạt kế hoạch],[Số chương trình])",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Member Conversions",
            "expression": "SUM(ProgramEvent[member_conversions])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Màu trạng thái chương trình",
            "expression": "SWITCH(SELECTEDVALUE(ProgramEvent[program_status]), \"Đúng kế hoạch\", \"#34D399\", \"Cần theo dõi\", \"#FBBF24\", \"Có rủi ro\", \"#FB923C\", \"Nghiêm trọng\", \"#F87171\", BLANK())",
            "displayFolder": "Formatting"
          }
        ],
        "partitions": [
          {
            "name": "ProgramEvent",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(DataRoot & \"\\program_event.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Selected = Table.SelectColumns(Headers, {\"program_id\", \"program_name\", \"program_type\", \"region\", \"event_date_utc\", \"capacity\", \"tickets_sold\", \"ticket_gmv\", \"service_fee\", \"sponsor_revenue\", \"refund_value\", \"variable_cost\", \"fixed_cost\", \"contribution_margin\", \"attendees\", \"no_shows\", \"new_customers\", \"member_conversions\", \"sales_pace_index\", \"break_even_progress\", \"forecast_margin_rate\", \"program_status\"}),\n    Typed = Table.TransformColumnTypes(Selected, {{\"program_id\", type text}, {\"program_name\", type text}, {\"program_type\", type text}, {\"region\", type text}, {\"event_date_utc\", type datetimezone}, {\"capacity\", Int64.Type}, {\"tickets_sold\", Int64.Type}, {\"ticket_gmv\", type number}, {\"service_fee\", type number}, {\"sponsor_revenue\", type number}, {\"refund_value\", type number}, {\"variable_cost\", type number}, {\"fixed_cost\", type number}, {\"contribution_margin\", type number}, {\"attendees\", Int64.Type}, {\"no_shows\", Int64.Type}, {\"new_customers\", Int64.Type}, {\"member_conversions\", Int64.Type}, {\"sales_pace_index\", type number}, {\"break_even_progress\", type number}, {\"forecast_margin_rate\", type number}, {\"program_status\", type text}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      },
