      },
      {
        "name": "OperationsRealtime",
        "description": "Governed Gold export: operations_realtime.csv. Definitions: docs/gold-metric-definitions.md.",
        "columns": [
          {
            "name": "event_time_utc",
            "dataType": "dateTime",
            "sourceColumn": "event_time_utc",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "dd/MM/yyyy HH:mm"
          },
          {
            "name": "event_date_utc",
            "dataType": "dateTime",
            "sourceColumn": "event_date_utc",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "dd/MM/yyyy HH:mm"
          },
          {
            "name": "service_name",
            "dataType": "string",
            "sourceColumn": "service_name",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "requests_per_second",
            "dataType": "int64",
            "sourceColumn": "requests_per_second",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "p95_latency_ms",
            "dataType": "double",
            "sourceColumn": "p95_latency_ms",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "error_rate",
            "dataType": "double",
            "sourceColumn": "error_rate",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "queue_depth",
            "dataType": "int64",
            "sourceColumn": "queue_depth",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "throughput_per_minute",
            "dataType": "int64",
            "sourceColumn": "throughput_per_minute",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "data_lag_seconds",
            "dataType": "double",
            "sourceColumn": "data_lag_seconds",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "status",
            "dataType": "string",
            "sourceColumn": "status",
            "summarizeBy": "none",
            "isHidden": false
          }
        ],
        "measures": [
          {
            "name": "P95 Latency cao nhất",
            "expression": "MAX(OperationsRealtime[p95_latency_ms])",
            "formatString": "#,0 ms",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Trạng thái hiện tại",
            "expression": "VAR T=MAX(OperationsRealtime[event_time_utc]) RETURN IF(CALCULATE(COUNTROWS(OperationsRealtime),OperationsRealtime[event_time_utc]=T,OperationsRealtime[status]=\"Cảnh báo\")>0,\"Cảnh báo\",\"Ổn định\")",
            "formatString": "",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Current RPS",
            "expression": "VAR T=MAX(OperationsRealtime[event_time_utc]) RETURN CALCULATE(SUM(OperationsRealtime[requests_per_second]),OperationsRealtime[event_time_utc]=T)",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "P95 Latency",
            "expression": "VAR T=MAX(OperationsRealtime[event_time_utc]) RETURN CALCULATE(MAX(OperationsRealtime[p95_latency_ms]),OperationsRealtime[event_time_utc]=T)",
            "formatString": "#,0 ms",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Error Rate",
            "expression": "VAR T=MAX(OperationsRealtime[event_time_utc]) RETURN CALCULATE(DIVIDE(SUMX(OperationsRealtime,OperationsRealtime[error_rate]*OperationsRealtime[requests_per_second]),SUM(OperationsRealtime[requests_per_second])),OperationsRealtime[event_time_utc]=T)",
            "formatString": "0.00%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Queue Depth",
            "expression": "VAR T=MAX(OperationsRealtime[event_time_utc]) RETURN CALCULATE(SUM(OperationsRealtime[queue_depth]),OperationsRealtime[event_time_utc]=T)",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Throughput / phút",
            "expression": "VAR T=MAX(OperationsRealtime[event_time_utc]) RETURN CALCULATE(SUM(OperationsRealtime[throughput_per_minute]),OperationsRealtime[event_time_utc]=T)",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Data Lag",
            "expression": "VAR T=MAX(OperationsRealtime[event_time_utc]) RETURN CALCULATE(MAX(OperationsRealtime[data_lag_seconds]),OperationsRealtime[event_time_utc]=T)",
            "formatString": "#,0.0 s",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Dịch vụ cảnh báo",
            "expression": "CALCULATE(DISTINCTCOUNT(OperationsRealtime[service_name]),OperationsRealtime[status]=\"Cảnh báo\")",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Màu trạng thái dịch vụ",
            "expression": "SWITCH([Trạng thái hiện tại], \"Ổn định\", \"#34D399\", \"Cảnh báo\", \"#F87171\", BLANK())",
            "displayFolder": "Formatting"
          }
        ],
        "partitions": [
          {
            "name": "OperationsRealtime",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(DataRoot & \"\\operations_realtime.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Selected = Table.SelectColumns(Headers, {\"event_time_utc\", \"event_date_utc\", \"service_name\", \"requests_per_second\", \"p95_latency_ms\", \"error_rate\", \"queue_depth\", \"throughput_per_minute\", \"data_lag_seconds\", \"status\"}),\n    Typed = Table.TransformColumnTypes(Selected, {{\"event_time_utc\", type datetimezone}, {\"event_date_utc\", type datetimezone}, {\"service_name\", type text}, {\"requests_per_second\", Int64.Type}, {\"p95_latency_ms\", type number}, {\"error_rate\", type number}, {\"queue_depth\", Int64.Type}, {\"throughput_per_minute\", Int64.Type}, {\"data_lag_seconds\", type number}, {\"status\", type text}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      }
    ],
    "relationships": [
      {
