            "sourceColumn": "play_events",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "completion_events",
            "dataType": "int64",
            "sourceColumn": "completion_events",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "completion_per_play_proxy",
            "dataType": "double",
            "sourceColumn": "completion_per_play_proxy",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "observed_position_seconds",
            "dataType": "double",
            "sourceColumn": "observed_position_seconds",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Sự kiện hoạt động",
            "expression": "SUM(ContentEngagement[activity_events])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Lượt phát",
            "expression": "SUM(ContentEngagement[play_events])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Lượt hoàn tất",
            "expression": "SUM(ContentEngagement[completion_events])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Tỷ lệ hoàn tất proxy",
            "expression": "DIVIDE([Lượt hoàn tất],[Lượt phát])",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Vị trí quan sát (giây)",
            "expression": "SUM(ContentEngagement[observed_position_seconds])",
            "formatString": "#,0.0",
            "displayFolder": "Dashboard"
          }
        ],
        "partitions": [
          {
            "name": "ContentEngagement",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(DataRoot & \"\\content_engagement_hourly.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Selected = Table.SelectColumns(Headers, {\"event_hour_utc\", \"event_date_utc\", \"content_id\", \"device_type\", \"activity_events\", \"active_users\", \"play_events\", \"completion_events\", \"completion_per_play_proxy\", \"observed_position_seconds\"}),\n    Typed = Table.TransformColumnTypes(Selected, {{\"event_hour_utc\", type datetimezone}, {\"event_date_utc\", type datetimezone}, {\"content_id\", type text}, {\"device_type\", type text}, {\"activity_events\", Int64.Type}, {\"active_users\", Int64.Type}, {\"play_events\", Int64.Type}, {\"completion_events\", Int64.Type}, {\"completion_per_play_proxy\", type number}, {\"observed_position_seconds\", type number}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      },
