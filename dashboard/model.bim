      {
        "name": "StreamingRealtime",
        "description": "Governed Gold export: streaming_realtime.csv. Definitions: docs/gold-metric-definitions.md.",
        "columns": [
          {
            "name": "event_time_utc",
            "dataType": "dateTime",
            "sourceColumn": "event_time_utc",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "dd/MM/yyyy HH:mm"
          },
          {
            "name": "event_date_utc",
            "dataType": "dateTime",
            "sourceColumn": "event_date_utc",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "dd/MM/yyyy HH:mm"
          },
          {
            "name": "device_type",
            "dataType": "string",
            "sourceColumn": "device_type",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "region",
            "dataType": "string",
            "sourceColumn": "region",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "concurrent_viewers",
            "dataType": "int64",
            "sourceColumn": "concurrent_viewers",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "watch_hours",
            "dataType": "decimal",
            "sourceColumn": "watch_hours",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "play_starts",
            "dataType": "int64",
            "sourceColumn": "play_starts",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "completions",
            "dataType": "int64",
            "sourceColumn": "completions",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "total_sessions",
            "dataType": "int64",
            "sourceColumn": "total_sessions",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "rebuffer_events",
            "dataType": "int64",
            "sourceColumn": "rebuffer_events",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "start_failures",
            "dataType": "int64",
            "sourceColumn": "start_failures",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "subscription_conversions",
            "dataType": "int64",
            "sourceColumn": "subscription_conversions",
            "summarizeBy": "none",
            "isHidden": true
          }
        ],
        "measures": [
          {
            "name": "Concurrent Viewers",
            "expression": "VAR T=MAX(StreamingRealtime[event_time_utc]) RETURN CALCULATE(SUM(StreamingRealtime[concurrent_viewers]),StreamingRealtime[event_time_utc]=T)",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Watch Hours",
            "expression": "SUM(StreamingRealtime[watch_hours])",
            "formatString": "#,0.0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Play Starts",
            "expression": "SUM(StreamingRealtime[play_starts])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Streaming Completions",
            "expression": "SUM(StreamingRealtime[completions])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Completion Rate",
            "expression": "DIVIDE([Streaming Completions],[Play Starts])",
            "formatString": "0.0%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Streaming Sessions",
            "expression": "SUM(StreamingRealtime[total_sessions])",
            "formatString": "#,0",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Rebuffer Ratio",
            "expression": "DIVIDE(SUM(StreamingRealtime[rebuffer_events]),[Streaming Sessions])",
            "formatString": "0.00%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Video Start Failure",
            "expression": "DIVIDE(SUM(StreamingRealtime[start_failures]),[Streaming Sessions])",
            "formatString": "0.00%",
            "displayFolder": "Dashboard"
          },
          {
            "name": "Streaming Conversion",
            "expression": "DIVIDE(SUM(StreamingRealtime[subscription_conversions]),[Streaming Sessions])",
            "formatString": "0.00%",
            "displayFolder": "Dashboard"
          }
        ],
        "partitions": [
          {
            "name": "StreamingRealtime",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": "let\n    Source = Csv.Document(File.Contents(DataRoot & \"\\streaming_realtime.csv\"), [Delimiter=\",\", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),\n    Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),\n    Selected = Table.SelectColumns(Headers, {\"event_time_utc\", \"event_date_utc\", \"device_type\", \"region\", \"concurrent_viewers\", \"watch_hours\", \"play_starts\", \"completions\", \"total_sessions\", \"rebuffer_events\", \"start_failures\", \"subscription_conversions\"}),\n    Typed = Table.TransformColumnTypes(Selected, {{\"event_time_utc\", type datetimezone}, {\"event_date_utc\", type datetimezone}, {\"device_type\", type text}, {\"region\", type text}, {\"concurrent_viewers\", Int64.Type}, {\"watch_hours\", type number}, {\"play_starts\", Int64.Type}, {\"completions\", Int64.Type}, {\"total_sessions\", Int64.Type}, {\"rebuffer_events\", Int64.Type}, {\"start_failures\", Int64.Type}, {\"subscription_conversions\", Int64.Type}}, \"en-US\")\nin\n    Typed"
            }
          }
        ]
      },
      {
        "name": "ProgramEvent",
        "description": "Governed Gold export: program_event.csv. Definitions: docs/gold-metric-definitions.md.",
        "columns": [
