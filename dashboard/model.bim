      },
      {
        "name": "CustomerActivity",
        "description": "Governed Gold export: customer_activity.csv. Definitions: docs/gold-metric-definitions.md.",
        "columns": [
          {
            "name": "event_id",
            "dataType": "string",
            "sourceColumn": "event_id",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "customer_id",
            "dataType": "string",
            "sourceColumn": "customer_id",
            "summarizeBy": "none",
            "isHidden": false
          },
          {
            "name": "occurred_at",
            "dataType": "dateTime",
            "sourceColumn": "occurred_at",
            "summarizeBy": "none",
            "isHidden": false,
            "formatString": "dd/MM/yyyy HH:mm"
          },
          {
            "name": "event_date_utc",
            "dataType": "dateTime",
            "sourceColumn": "event_date_utc",
